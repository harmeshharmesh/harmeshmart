# HarmeshMart Environment Variables Example
# Copy to .env for deployment or overrides

# Database Configuration
DB_URL=jdbc:h2:file:./data/harmeshmart;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=

# AI Chatbot Configuration
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=

# Server Configuration
SERVER_PORT=8080
CONTEXT_PATH=/HarmeshMart
