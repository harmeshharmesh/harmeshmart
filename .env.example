# ==============================================================================
# HarmeshMart Environment Variables Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: In-Memory H2 (Default for Render Free Tier - zero file locking, auto-seeded on every boot)
DB_URL=jdbc:h2:mem:harmeshmart;DB_CLOSE_DELAY=-1

# Option B: File-based H2 (Use if Render Persistent Disk is attached at /var/data)
# DB_URL=jdbc:h2:file:/var/data/harmeshmart/db;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE

# Option C: Local Development File Path
# DB_URL=jdbc:h2:file:./data/harmeshmart;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE

DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 2. AI ASSISTANT / CHATBOT CONFIGURATION
# ------------------------------------------------------------------------------
# Provider Options: 'mock' (rule-based offline simulator) or 'gemini' (Google Gemini AI)
AI_CHATBOT_PROVIDER=mock

# Required only if AI_CHATBOT_PROVIDER=gemini
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. WEB SERVER & CONTAINER PORT CONFIGURATION
# ------------------------------------------------------------------------------
# Render automatically injects $PORT (usually 10000). The docker-entrypoint.sh
# automatically binds Apache Tomcat to whatever $PORT is provided.
PORT=10000

# JVM Memory Tuning (recommended for Render 512MB free tier containers)
JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseG1GC -Djava.awt.headless=true
